{
  "name": "hugo-rollup-project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:js": "rollup -c",
    "build:site": "hugo -s site",
    "build:questions": "node site/themes/design-system/scripts/build-questions.js --auto-fix",
    "build": "npm-run-all build:js build:questions build:site",
    "dev": "npm-run-all --parallel watch:js watch:questions serve:hugo",
    "watch:js": "rollup -c -w",
    "watch:questions": "node site/themes/design-system/scripts/build-questions.js --watch --auto-fix",
    "serve:hugo": "hugo server -s site --themesDir ../.. --bind 0.0.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "glob": "^10.3.10",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "practice-js": "github:gurukulams/practice-js",
    "gray-matter": "^4.0.3",
    "jsonschema": "^1.5.0",
    "chokidar": "^5.0.0"
  }
}
